#!/bin/sh
# Backstop for sessions where the attribution setting is absent, such as other tools or older clients.
# Trailer keys are case-insensitive in git, hence the bracket classes; cat -s collapses the blank lines left behind.
sed -E '/^[Cc][Oo]-[Aa][Uu][Tt][Hh][Oo][Rr][Ee][Dd]-[Bb][Yy]:[[:space:]]*[Cc][Ll][Aa][Uu][Dd][Ee]/d; /^[Cc][Ll][Aa][Uu][Dd][Ee]-[Ss][Ee][Ss][Ss][Ii][Oo][Nn]:/d; /^[^[:alnum:]]*Generated with \[?Claude Code/d' "$1" | cat -s > "$1.tmp" && mv "$1.tmp" "$1"
